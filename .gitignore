# 依赖与构建产物
node_modules/
dist/

# SQLite 数据文件（判断记录是运行时数据，不入库）
*.db
*.db-journal
*.db-wal

# 动作输出的落文件（第一版用来代替真实 MR 评论）
var/

# 本机临时
.slim/
*.log

# DSH 的记忆目录 —— 这是**本机状态**，不是项目内容。
# ⚠️ 不忽略它的后果很具体：发布流程第 ④ 步那句 `git add -A` 会把它一并加进公开仓，
#    而第 ① 步的 `git grep` 只看**已跟踪**文件，扫不到未跟踪的它 ——
#    于是「扫描说干净」与「确实带走了东西」同时成立，且没有人会去核对。
.dsh/
